// Pond frog, crouched at rest. Units: mm; forward is -Y; Z is up.
// Compile with GPU (f32), Grid 280. All geometry supports GPU evaluation.
// Broad anatomical forms blend with quartic metaballs; no fn_solid.

module flesh(p, r, a=0) {
    translate(p) rotate([0,0,a]) scale(r/1.42) sphere_metaball(1);
}

// Tangent connector between unequal spheres, as an SDF.
module link(p,q,r0,r1) {
    v=q-p; d=norm(v); k=(r0-r1)/d; c=sqrt(1-k*k);
    translate(p) sphere_sdf(r0);
    translate(q) sphere_sdf(r1);
    translate(p+v*(k*r0/d))
        rotate(a=acos(v[2]/d),v=[-v[1],v[0],0])
            cylinder_sdf(h=d-k*(r0-r1),r1=r0*c,r2=r1*c);
}
function curve(a,b,c,t) = a*(1-t)*(1-t)+b*2*t*(1-t)+c*t*t;
module digit(a,b,c,r0,r1) {
    metaball() union() {
        for(i=[0:7])
            link(curve(a,b,c,i/8),curve(a,b,c,(i+1)/8),
                 r0+(r1-r0)*i/8,r0+(r1-r0)*(i+1)/8);
    }
}
module long_flesh(p,q,width,depth) {
    v=q-p; d=norm(v);
    translate((p+q)/2)
        rotate(a=acos(v[2]/d),v=[-v[1],v[0],0])
            scale([width,depth,d/2+width]/1.42) sphere_metaball(1);
}

