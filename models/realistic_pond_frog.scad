module anatomy() {
    metaball_solid(0.42,falloff="quartic") {
        dorsal_folds();
        skin_detail();
        // Pear-shaped trunk, broad skull and low snout.
        flesh([0,3,20],[21,31,15]);
        flesh([0,-24,26],[24,18,10]);
        flesh([0,-33,24],[16,9,6]);
        flesh([0,-26,19],[20,13,7]);
        for(s=[-1,1]) {
            // Brow mounds emerge from the skull.
            flesh([s*14,-23,33],[7.8,8.5,8]);
            // Pelvis and powerful thigh, with the knee pointing forward.
            flesh([s*21,17,13],[14,21,12],s*26);
            flesh([s*30,7,9],[10,12,8],s*18);
            // Folded tibia returns back toward the heel.
            long_flesh([s*34,9,7],[s*32,31,4.7],5.3,5.0);
            flesh([s*31,30,4.3],[5,6.5,3.5]);
            // Elongated ankle and a splayed hind foot beside the body.
            long_flesh([s*32,30,4],[s*42,14,3.4],3.5,2.7);
            flesh([s*42,12,3.2],[5.2,8,2.6],s*22);
            // Five distinct rear toes, gently curved and robust at their tips.
            digit([s*40,9,3],[s*34,3,2.6],[s*34,-4,2],1.7,0.95);
            digit([s*42,8,3],[s*39,-1,2.1],[s*41,-9,1.9],1.9,1.05);
