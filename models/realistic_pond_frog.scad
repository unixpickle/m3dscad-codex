            digit([s*46,15,3],[s*54,12,2],[s*62,7,1.8],1.6,0.95);
            // Forelimbs carry the chest, elbows slightly behind the shoulders.
            long_flesh([s*19,-17,21],[s*26,-14,11],5.0,4.8);
            flesh([s*26,-15,10],[5.3,5.5,5]);
